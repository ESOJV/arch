{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 0,

    "modules-left": [
        "custom/start",
        "group/left"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "group/right",
        "custom/ctlcenter",
        "tray"
    ],

    // ── Groups ────────────────────────────────────────────────────────────────

    "group/left": {
        "orientation": "horizontal",
        "modules": [
            "hyprland/workspaces",
            "hyprland/window"
        ]
    },

    "group/right": {
        "orientation": "horizontal",
        "modules": [
            "battery",
            "pulseaudio",
            "network"
        ]
    },

    // ── Custom ────────────────────────────────────────────────────────────────

    "custom/start": {
        "format": "󱄅",
        "tooltip": false,
        "on-click": "wofi --show drun"
    },

    "custom/ctlcenter": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/powermenu.sh"
    },

    // ── Workspaces / Window ───────────────────────────────────────────────────

    "hyprland/workspaces": {
        "format": "{id}",
        "sort-by-number": true,
        "on-click": "activate"
    },

    "hyprland/window": {
        "max-length": 35,
        "separate-outputs": true
    },

    // ── Media / Clock ─────────────────────────────────────────────────────────

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "player-icons": {
            "default": "▶",
            "spotify": "",
            "firefox": "󰈹",
            "chromium": ""
        },
        "status-icons": {
            "paused": "⏸"
        },
        "dynamic-len": 30,
        "dynamic-order": ["title", "artist"],
        "tooltip-format": "{title}\n{artist}"
    },

    "clock": {
        "format": " {:%I:%M %p}",
        "format-alt": " {:%A, %B %d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#efefef'><b>{}</b></span>",
                "weekdays": "<span color='#909090'><b>{}</b></span>",
                "today":    "<span color='#ffffff'><b><u>{}</u></b></span>"
            }
        }
    },

    // ── Battery ───────────────────────────────────────────────────────────────

    "battery": {
        "bat": "BAT1",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged":  "󱞜 {capacity}%",
        "format-icons": ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
        "tooltip-format": "{timeTo}\n{power}W draw"
    },

    // ── Audio ─────────────────────────────────────────────────────────────────

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "headphone": "󰋋",
            "headset":   "󰋎",
            "default":   ["󰕿","󰖀","󰕾"]
        },
        "on-click": "pavucontrol",
        "tooltip-format": "{desc}"
    },

    // ── Network ───────────────────────────────────────────────────────────────

    "network": {
        "format-wifi":         "󰖩 {signalStrength}%",
        "format-ethernet":     "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi":     "{essid} · {signalStrength}%",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 5,
        "on-click": "nm-connection-editor"
    },

    // ── Tray ──────────────────────────────────────────────────────────────────

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
